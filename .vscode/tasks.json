{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "블로그: 미리보기 시작",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/preview.ps1"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "블로그: 새 논문 리뷰",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/new-review.ps1", "-Slug", "${input:slug}", "-Title", "${input:title}"],
      "problemMatcher": []
    },
    {
      "label": "블로그: 발행 화면 빌드",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    }
  ],
  "inputs": [
    {"id": "slug", "type": "promptString", "description": "영문 폴더명 (예: bevformer-review)"},
    {"id": "title", "type": "promptString", "description": "글 제목"}
  ]
}

